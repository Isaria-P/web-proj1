<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <link rel="stylesheet" href="/static/css/main.css">
        <link
            rel="shortcut icon"
            href="/static/img/favicon.ico"
            type="image/x-icon"
        >
        <link
            <link rel="preconnect" href="https://fonts.googleapis.com">
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
            <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Fira+Sans:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
        
        <title>{% block title %}{% endblock %} - Filmcam</title>
    </head>
    <body>
        <header>
            <h1><a href="/">Filmcam</a></h1>
        </header>
        {% include 'partials/nav.jinja' %}
        <main>
            <p>Account ID: {{ session.get("account_id") }}</p>
            {% for message in get_flashed_messages() %}
                <p class="flash">{{ message }}</p>
            {% endfor %}
            {% block main %}{% endblock %}
        </main>
        <footer>
            Powered by <a href="https://flask.palletsprojects.com/en/stable/"
            >Flask</a>
        </footer>
    </body>
</html>