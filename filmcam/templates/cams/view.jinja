{% extends "base.jinja" %}
{% block title %}{{ cam.title }}{% endblock %}
{% block main %}
<div class="view-grid">
    <!-- <h3>{{ cam.title }}</h3> -->
    
    <!-- <hr> -->
    <div class="card-grid">
        <div class="card">
            <div class="card-img">
                <!-- <p>{{ cam.id }}</a></p> -->
                <img 
                    src="{{ url_for('static', filename='uploads/' + cam.img) }}" 
                    alt="{{ cam.title }}">
                    <br>
            </div>
            <div class="card-content">     
                <!-- <p>Image path: {{ cam.img }} : src="{{ cam.upload_file }}</p> -->
                <h2 class="card-title">{{ cam.title }} </h2>  
                <p alt="{{ cam.category }}">Category: {{ cam.category }}</p>
                <p alt="{{ cam.content }}">{{ cam.content }}</p>
                <p>Created: {{ cam.created }}</p>
            </div> 
        </div>
    </div>
    <hr>
</div>
{% endblock %}