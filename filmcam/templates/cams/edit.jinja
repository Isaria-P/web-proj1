{% extends "base.jinja" %}
{% block title %}Edit Cam Post{% endblock %}
{% block main %}

    <h2>Edit Cam Post</h2>

    <form
        action="{{ url_for('cams.edit_submit', cam_id=cam.id) }}"
        method="POST"
        enctype="multipart/form-data"
    >

        <label>
            Title:

            {% if form and form.field_errors.get("title") %}
                <p class="error">
                    {{ form.field_errors["title"] }}
                </p>
            {% endif %}

            <input
                type="text"
                name="title"
                value="{{ cam.title }}"
                required
                maxlength="100"
            >
        </label>
        <label>
            Content:

            {% if form and form.field_errors.get("content") %}
                <p class="error">
                    {{ form.field_errors["content"] }}
                </p>
            {% endif %}

            <textarea
                name="content"
                required
            >{{ cam.content }}</textarea>
        </label>
        

        <!-- Current Image -->
        <div class="current-image">
            <p>Current image:</p>
            <img
                src="{{ url_for('static', filename='uploads/' + cam.img) }}"
                alt="{{ cam.title }}"
                width="300"
            >
            <p>
                {{ cam.img }}
            </p>

        </div>
        <!-- New Image -->
        <label>
            Replace image:

            <input
                type="file"
                name="img"
                accept="image/*"
            >
        </label>

        <small>
            Leave blank to keep the current image.
        </small>

        <fieldset>

            <legend>Category:</legend>

            {% if form and form.field_errors.get("category") %}
                <p class="error">
                    {{ form.field_errors["category"] }}
                </p>
            {% endif %}

            <label>
                <input
                    type="radio"
                    name="category"
                    value="35 mm"
                    {% if cam.category == "35 mm" %}
                        checked
                    {% endif %}
                    required
                >
                35 mm
            </label>
            <label>
                <input
                    type="radio"
                    name="category"
                    value="medium format"
                    {% if cam.category == "medium format" %}
                        checked
                    {% endif %}
                >
                Medium format
            </label>
            <label>
                <input
                    type="radio"
                    name="category"
                    value="large format"
                    {% if cam.category == "large format" %}
                        checked
                    {% endif %}
                >
                Large format
            </label>
        </fieldset>


        <!-- Submit -->
        <button type="submit">
            Save Changes
        </button>

    </form>


    <!-- Cancel -->
    <a href="{{ url_for('cams.view', cam_id=cam.id) }}">
        Cancel
    </a>

{% endblock %}